<script setup>
import { ref } from 'vue'

// [1단계] 날씨 목록 데이터
const weatherList = ref([
  { id: 'city_01', name: '서울', temp: 28, status: '맑음' },
  { id: 'city_02', name: '수원', temp: 24, status: '비' },
  { id: 'city_03', name: '부산', temp: 26, status: '구름' },
])

// [4단계] 검색어 상태
const searchQuery = ref('')

// 하단 상태바에 띄울 안내 문구
const selectedCityInfo = ref('카드를 클릭하거나 검색해 보세요.')

// 더움/선선함을 가르는 기준 온도.
const HOT_TEMP = 25

// 카드 클릭 시 상태바 문구 변경
const selectCity = (city) => {
  selectedCityInfo.value = `${city.name} 선택됨 · ${city.temp}°C · ${city.status}`
}


const showDetail = (city) => {
  selectedCityInfo.value = `[상세] ${city.name}의 현재 날씨는 '${city.status}', 기온은 ${city.temp}°C 입니다.`
}
</script>

<template>
  <div class="dashboard-wrapper">
    <h2>🌤️ 날씨 Mockup (1일차)</h2>
    <section class="search-box">
      <h3>🔍 도시 검색</h3>
      <input
        type="text"
        :value="searchQuery"
        @input="(e) => (searchQuery = e.target.value)"
        placeholder="검색할 도시 이름 입력 (예: 서울)"
      />
      <p>
        검색 중인 도시: <strong>{{ searchQuery || '(입력 없음)' }}</strong>
      </p>
    </section>

    <section class="list-box">
      <h3>🏙️ 지역별 날씨 현황</h3>

      <!-- [2단계] :key 에는 반드시 고유한 id 를 쓴다.
           index 를 쓰면 목록 중간이 삭제될 때 Vue 가 엉뚱한 DOM 을 재사용한다. -->
      <div
        v-for="city in weatherList"
        :key="city.id"
        class="weather-card"
        @click="selectCity(city)"
      >
        <h4>{{ city.name }} ({{ city.status }})</h4>
        <p>현재 기온: {{ city.temp }}°C</p>

        <!-- [3단계] v-if / v-else 는 조건이 거짓이면 DOM 에서 아예 제거된다. -->
        <span v-if="city.temp >= HOT_TEMP" class="badge hot">🔥 더움 ({{ HOT_TEMP }}도 이상)</span>
        <span v-else class="badge cool">❄️ 선선함 ({{ HOT_TEMP }}도 미만)</span>

        <!-- .stop 이 없으면 부모 div 의 @click 까지 같이 실행된다 (이벤트 버블링) -->
        <button class="btn-detail" @click.stop="showDetail(city)">상세보기</button>
      </div>
    </section>

    <div class="status-bar">{{ selectedCityInfo }}</div>
  </div>
</template>

<style scoped>
.dashboard-wrapper {
  max-width: 640px;
  margin: 0 auto;
  padding: 16px;
  font-family: system-ui, sans-serif;
}

.search-box input {
  width: 100%;
  padding: 10px;
  font-size: 15px;
  border: 1px solid #ccc;
  border-radius: 6px;
  box-sizing: border-box;
}

.weather-card {
  border: 1px solid #ddd;
  border-radius: 8px;
  padding: 14px;
  margin-bottom: 10px;
  cursor: pointer;
  transition: box-shadow 0.15s;
}

.weather-card:hover {
  box-shadow: 0 2px 8px rgb(0 0 0 / 12%);
}

.weather-card h4 {
  margin: 0 0 6px;
}

.weather-card p {
  margin: 0 0 8px;
  color: #555;
}

.badge {
  display: inline-block;
  padding: 4px 10px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: bold;
}

.badge.hot {
  background: #ffe0e0;
  color: #c62828;
}

.badge.cool {
  background: #e0f0ff;
  color: #1565c0;
}

.btn-detail {
  float: right;
  padding: 5px 12px;
  border: 1px solid #999;
  border-radius: 6px;
  background: #fff;
  cursor: pointer;
}

.status-bar {
  background: #e8f5e9;
  padding: 10px;
  text-align: center;
  color: #2e7d32;
  font-weight: bold;
  border-radius: 6px;
}
</style>
